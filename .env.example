# ---- core ----
ASUNSET_ENV=dev

# ---- postgres (shared instance; three logical DBs) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres
# app db — two roles on purpose:
#   * APP_OWNER runs migrations and admin ops (bootstrap, reconcile).
#     It owns the schema, so RLS policies don't apply to it.
#   * APP_USER is what the API connects as for ordinary request handling.
#     Non-owner + no BYPASSRLS, so every query is subject to RLS policies.
APP_DB_NAME=asunset
APP_DB_OWNER=asunset_owner
APP_DB_OWNER_PASSWORD=change-me-owner
APP_DB_USER=asunset
APP_DB_PASSWORD=change-me-app
# keycloak db
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me-kc
# openfga db
FGA_DB_NAME=openfga
FGA_DB_USER=openfga
FGA_DB_PASSWORD=change-me-fga

# ---- keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-admin
KEYCLOAK_REALM=asunset
# Public-facing URL the browser hits (must match issuer in JWTs)
KEYCLOAK_PUBLIC_URL=http://localhost:8080
# Internal URL the API uses to reach Keycloak (service DNS inside compose)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_API_CLIENT_ID=asunset-api
KEYCLOAK_API_CLIENT_SECRET=change-me-api-client
KEYCLOAK_WEB_CLIENT_ID=asunset-web

# ---- openfga ----
OPENFGA_API_URL=http://openfga:8080
OPENFGA_STORE_NAME=asunset
# Preshared-key auth between the API and OpenFGA. Rotate on credential
# compromise; both the server (OPENFGA_AUTHN_PRESHARED_KEYS) and the
# client (this value) must match.
OPENFGA_API_KEY=change-me-openfga-key

# ---- api ----
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_LOG_LEVEL=info

# ---- web ----
WEB_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=asunset
VITE_KEYCLOAK_CLIENT_ID=asunset-web

# ---- TLS mode (activated by compose.tls.yml) ----
# When the overlay is active, Caddy terminates TLS at these hostnames.
# Add them to your /etc/hosts pointing at 127.0.0.1 for local dev.
# In prod, set to your real DNS and replace the Caddyfile's `tls internal`
# with operator-supplied certs (or let Caddy ACME-issue via Let's Encrypt).
TLS_WEB_HOST=asunset.local
TLS_AUTH_HOST=auth.asunset.local
TLS_API_HOST=api.asunset.local

# ---- vector / audit pipeline ----
VECTOR_LOG_LEVEL=info
